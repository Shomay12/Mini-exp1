# Web Intelligence Engine Configuration
# Copy to .env and configure values as needed. Never commit .env!

APP_NAME="Local-First Web Intelligence Engine"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT="8000"
LOG_LEVEL="INFO"

# Local SQLite database path
DATABASE_PATH="./data/web_intelligence.db"
RETENTION_DAYS="30"

# Search provider priority (comma-separated: mock, brave, tavily, exa)
# Defaults to mock so the system runs completely offline without API credentials.
SEARCH_PROVIDERS="mock"
ENABLE_MOCK_PROVIDER="true"

# Optional Search API Credentials (leave blank when using mock)
BRAVE_API_KEY=""
TAVILY_API_KEY=""
EXA_API_KEY=""

# Privacy & Network Controls
ALLOW_LIVE_NETWORK="true"
RESPECT_ROBOTS_TXT="true"
HTTP_PROXY=""
HTTPS_PROXY=""
ENABLE_TELEMETRY="false"
DISCLOSE_OUTBOUND_QUERIES="true"

# Retrieval Limits
REQUEST_TIMEOUT_SECONDS="15.0"
CONNECT_TIMEOUT_SECONDS="5.0"
MAX_REDIRECTS="5"
MAX_DOWNLOAD_BYTES="2000000"
MAX_CONCURRENT_FETCHES="4"
PER_HOST_MIN_INTERVAL_SECONDS="0.5"
MAX_RESULTS_PER_QUERY="6"
MAX_FETCH_URLS="8"
USER_AGENT="AdaptiveResearchEngine/0.2 (+local-first-web-intelligence)"
